    "test:cpp": "vitest run --config vitest.cpp.config.mts"
  },
  "dependencies": {
    "monaco-editor": "0.57.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "framer-motion": "^14.0.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.52.0",
    "mp4-muxer": "^5.2.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.3"
